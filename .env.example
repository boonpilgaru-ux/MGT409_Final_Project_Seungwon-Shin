# Required for live model calls; get this from the course/Portkey setup.
PORTKEY_API_KEY=replace_with_your_course_portkey_key

# Optional. Every Tee:dentity model feature is fixed to gpt-6-luna for course-key compliance.
PORTKEY_BASE_URL=https://api.portkey.ai/v1
TEE_DB_PATH=
TEE_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
TEE_ALLOWED_HOSTS=localhost,127.0.0.1
TEE_LLM_TIMEOUT=90
TEE_PUBLIC_URL=http://localhost:5173
TEE_USER_AGENT=
TEE_QUESTION_EFFORT=none
TEE_SESSION_RETENTION_DAYS=30
TEE_RATE_LIMIT_BURST=60
TEE_RATE_LIMIT_PER_MIN=20
TEE_PARSE_MEMORY_MB=512

# Frontend dev/preview API proxy. run.ps1 sets this automatically on Windows.
TEE_API_URL=http://127.0.0.1:8000
